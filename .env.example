# LLM (Google AI Studio / OpenAI compatible)
LOCAL_DEV_PROFILE=true
# Only Check/Start/Stop are supported; failed startup leaves no API running.
# start_local.ps1 pins the validated pair and disables model downloads/rewrite.
# RAM/commit measurements are diagnostic only; allocation failures are reported.
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# Auth
JWT_SECRET_KEY=your_random_256bit_secret_here
JWT_EXPIRY_HOURS=24

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/admitai.db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=admitai_chunks_phase_a_20261019_223230
QDRANT_UPSERT_BATCH_SIZE=128

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BACKEND=lite
QUERY_REWRITE_ENABLED=false
MODELS_LOCAL_ONLY=true
# Optional Hugging Face read token for authenticated model downloads
HF_TOKEN=

# RAG Config
RETRIEVAL_TOP_K=20
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RERANK_CANDIDATE_K=8
RERANK_TOP_K=5
LITE_CANDIDATE_K=60
LITE_MAX_BRANCH_CANDIDATES=360
LITE_RRF_K=60
LITE_DENSE_WEIGHT=1.0
LITE_SPARSE_WEIGHT=1.5
LITE_DOMAIN_MIN_FACTOR=0.25
LITE_DOMAIN_MAX_FACTOR=4.0
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=32
INDEX_DIR=data/index/module3-phase-a-20261019-223230
TABLE_CHUNK_SIZE=500
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300
RETRIEVAL_MIN_SCORE=0.68
RETRIEVAL_MIN_LEXICAL_COVERAGE=0.50
