# LLM (Google AI Studio / OpenAI compatible)
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# Auth
JWT_SECRET_KEY=your_random_256bit_secret_here
JWT_EXPIRY_HOURS=24

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/admitai.db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=admitai_chunks
QDRANT_UPSERT_BATCH_SIZE=128

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# RAG Config
RETRIEVAL_TOP_K=20
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RERANK_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=32
INDEX_DIR=data/index/naive_dense
RETRIEVAL_MIN_SCORE=0.68
RETRIEVAL_MIN_LEXICAL_COVERAGE=0.50
