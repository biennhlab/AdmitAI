# LLM (NVIDIA NIM)
NVIDIA_API_KEY=your_nvidia_api_key_here
LLM_MODEL=meta/llama-3.1-70b-instruct


# Auth
JWT_SECRET_KEY=your_random_256bit_secret_here
JWT_EXPIRY_HOURS=24

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/admitai.db

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=admitai_chunks

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# RAG Config
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=32
INDEX_DIR=data/index/naive_dense
RETRIEVAL_MIN_SCORE=0.68
RETRIEVAL_MIN_LEXICAL_COVERAGE=0.50
